{
  "name": "pi-background-monitor",
  "version": "0.1.0",
  "description": "Dedicated tmux background job monitoring for Pi",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "test": "tsx --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typebox": "^1.3.27",
    "typescript": "^5.9.0"
  }
}
