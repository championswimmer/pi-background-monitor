{
  "name": "pi-background-monitor",
  "version": "1.2.0",
  "description": "Dedicated tmux background job monitoring for Pi",
  "keywords": [
    "pi-package",
    "pi",
    "tmux",
    "background jobs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/championswimmer/pi-background-monitor.git"
  },
  "bugs": "https://github.com/championswimmer/pi-background-monitor/issues",
  "homepage": "https://github.com/championswimmer/pi-background-monitor#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node -e \"import('node:fs').then(fs => { for (const f of fs.readdirSync('dist')) if (f.endsWith('.d.ts') && f !== 'index.d.ts') fs.unlinkSync('dist/' + f); for (const f of ['capture.mjs', 'text.mjs']) fs.copyFileSync('src/' + f, 'dist/' + f); })\"",
    "clean": "rm -rf dist",
    "check": "tsc --noEmit",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "test": "tsx --test tests/*.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm run check && npm run lint && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typebox": "^1.3.27",
    "typescript": "^5.9.0"
  }
}
